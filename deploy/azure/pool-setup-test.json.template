{
  "id": "wf5_test",
  "vmSize": "Standard_L8as_v3",
  "taskSchedulingPolicy": {
    "nodeFillType": "spread"
  },
  "taskSlotsPerNode": 8,
  "targetDedicatedNodes": 0,
  "virtualMachineConfiguration": {
    "imageReference": {
      "publisher": "microsoft-dsvm",
      "offer": "ubuntu-hpc",
      "sku": "2404"
    },
    "nodeAgentSKUId": "batch.node.ubuntu 24.04",
    "containerConfiguration": {
      "type": "dockerCompatible"
    }
  },
  "startTask": {
    "commandLine": "/bin/bash setup.sh",
    "resourceFiles": [
      {
        "httpUrl": "https://daffstandard.blob.core.windows.net/scripts/wf5/setup.sh?<SETUP_SCRIPT_SAS_TOKEN>",
        "filePath": "setup.sh"
      }
    ],
    "waitForSuccess": true,
    "userIdentity": {
      "autoUser": {
        "scope": "pool",
        "elevationLevel": "admin"
      }
    }
  }
}
