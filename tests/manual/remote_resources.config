// daff-admin override: host has 4 vCPU / 7.8 GB RAM total (~7.1 GB
// available), well below the process_medium (16 GB) / process_high
// (32 GB) tiers in conf/base.config. Same approach as
// conf/integration.config uses for GitHub Actions runners and
// tests/manual/local_resources.config uses for the developer
// workstation, sized from `nproc` / `free -h` observed on daff-admin
// itself (task 49).
process {
    resourceLimits = [ cpus: 4, memory: '6.GB', time: '24.h' ]
}
