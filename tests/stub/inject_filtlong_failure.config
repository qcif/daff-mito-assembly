// Failure injection: STUB-02's FILTLONG stub fails upstream of gzip,
// as a real filtlong crash does inside `filtlong ... | gzip`.
process {
    withName: 'FILTLONG' {
        ext.stub_upstream = {
            meta.sample_id == 'STUB-02'
                ? "echo 'Error: duplicate read name: INJECTED' >&2; exit 1"
                : null
        }
    }
}
