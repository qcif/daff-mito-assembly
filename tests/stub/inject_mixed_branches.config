// Failure injection: STUB-02 fails the coverage gate (so the two samples
// sit on different branches) and its NANOPLOT_RAW also fails. Each sample
// must reach COLLATE exactly once.
process {
    withName: 'COVERAGE_GATE' {
        ext.stub_status = { meta.sample_id == 'STUB-02' ? 'fail' : 'ok' }
    }
    withName: 'NANOPLOT_RAW' {
        beforeScript = {
            meta.sample_id == 'STUB-02'
                ? "echo 'INJECTED NanoPlot failure' >&2; exit 1"
                : ''
        }
    }
}
