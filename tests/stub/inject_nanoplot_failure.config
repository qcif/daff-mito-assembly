// Failure injection: NANOPLOT_RAW fails for STUB-02 only. NanoPlot is a
// QC-only stage, so STUB-02 must still reach COLLATE.
process {
    withName: 'NANOPLOT_RAW' {
        beforeScript = {
            meta.sample_id == 'STUB-02'
                ? "echo 'INJECTED NanoPlot failure' >&2; exit 1"
                : ''
        }
    }
}
