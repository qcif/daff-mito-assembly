manifest {
    name            = 'qcif/daff-mito-assembly'
    author          = 'QCIF'
    description     = 'Organelle genome assembly + barcode recovery for biosecurity identification'
    version         = '0.1.0'
    nextflowVersion = '>=25.04.0'
    mainScript      = 'main.nf'
}

plugins {
    id 'nf-schema@2.4.0'
}

params {
    // --- Required ---
    samplesheet             = null
    data_dir                = null

    // --- Outputs ---
    outdir                  = 'results'
    publish_intermediates   = false

    // --- Reference data (populated per-run or via profile) ---
    organelle_refs          = null
    locus_panel             = null
    blast_db                = null

    // --- QC thresholds ---
    min_read_length         = 500
    min_mean_q              = 10
    filtlong_keep_percent   = 95

    // --- Coverage gate ---
    seqtk_seed              = 42

    // --- Assembly ---
    polish                  = false

    // --- Validation schema ---
    validate_params         = true
}

validation {
    monochromeLogs          = false
    defaultIgnoreParams     = ['validate_params']
}

// Load process resource labels
includeConfig 'conf/base.config'

// Load container map
includeConfig 'conf/containers.config'

profiles {
    stub                 { includeConfig 'conf/stub.config'                  }
    azure                { includeConfig 'conf/azure.config'                 }
    docker  {
        docker.enabled          = true
        docker.runOptions       = '-u $(id -u):$(id -g) --platform linux/amd64'
        singularity.enabled     = false
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        docker.enabled          = false
    }
}
