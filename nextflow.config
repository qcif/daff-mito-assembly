manifest {
    name            = 'qcif/daff-mito-assembly'
    author          = 'QCIF'
    description     = 'Organelle genome assembly + barcode recovery for biosecurity identification'
    version         = '0.1.0'
    nextflowVersion = '>=25.04.0'
    mainScript      = 'main.nf'
}

plugins {
    id 'nf-schema@2.4.0'
}

params {
    // --- Required ---
    samplesheet             = null
    data_dir                = null

    // --- Outputs ---
    outdir                  = 'results'
    publish_intermediates   = false

    // --- Reference data (populated per-run or via profile) ---
    organelle_refs          = null
    locus_panel             = null
    blast_db                = null

    // --- QC thresholds ---
    min_read_length         = 500
    min_mean_q              = 10
    filtlong_keep_percent   = 95

    // --- Coverage gate ---
    seqtk_seed              = 42

    // Coverage-gate limits — spec §2.1.1 defaults.
    // Overridable per-run with e.g. --coverage_limits.animal_mt.min_cov 20
    // PROVISIONAL: min/max are prior-art defaults, never validated against
    // our own data. The integration fixtures cannot validate them — they
    // are correctness tests, not benchmarks (spec §5.1). See §9 item 2.
    coverage_limits = [
        animal_mt: [ nominal_size:  17000, min_cov: 30, max_cov: 300 ],
        plant_pt:  [ nominal_size: 150000, min_cov: 30, max_cov: 500 ],
        plant_mt:  [ nominal_size: 400000, min_cov: 30, max_cov: 300 ],
    ]

    // --- Assembly ---
    polish                  = false

    // Flye --genome-size hints — spec §3.4.
    // Distinct from coverage_limits.nominal_size: advisory hint to Flye's
    // coverage estimator, not a length filter.
    assembly_size_hints = [
        animal_mt: '20k',
        plant_pt:  '150k',
        plant_mt:  '2m',
    ]

    // NCBI genetic-code tables per assembly target — spec §3.1.
    // animal_mt entry is a two-table clade trial per spec §3.3; C3 selects
    // the table under which the primary contig yields the longest valid ORF.
    genetic_code_tables = [
        animal_mt: [2, 5],   // vertebrate / invertebrate — trial both
        plant_pt:  [11],     // bacterial/plastid
        plant_mt:  [1],      // standard
    ]

    // --- Recruitment (RECRUIT / stage 5) ---

    // Per-target read-selection floors — spec §2 stage 5, §9 item 1.
    // A read is recruited when its MERGED aligned extent against
    // ${assembly_target}.mmi clears both floors. Merged aligned extent
    // replaced `samtools view -q 1` because MAPQ measures which panel
    // *genome* a read came from, which recruitment does not ask, and
    // inverts against the target on broad redundant panels
    // (task 28 §9.5).
    //
    //   min_aligned_frac   merged aligned bases / read length
    //   min_aligned_bp     merged aligned bases
    //
    // BOTH DEFAULT TO 0 — i.e. any read with an alignment is recruited.
    // Every non-zero value tried moved an integration fixture outside
    // its expected coverage bounds, most severely on `plant_mt`, whose
    // genuine reads match the panel over only part of their length
    // (task 28 §10.2). Note that is a statement about the fixtures, not
    // about the right value: those bounds come from the same
    // under-powered data, so tuning against them is circular
    // (spec §5.1). Treat 0/0 as "not yet determined", and set it from
    // the P3 datasets per §9 item 1 — the knobs exist so that is a
    // config sweep rather than a code change, as with
    // bin_target_thresholds below.
    recruit_thresholds = [
        animal_mt: [min_aligned_frac: 0.0, min_aligned_bp: 0],
        plant_pt:  [min_aligned_frac: 0.0, min_aligned_bp: 0],
        plant_mt:  [min_aligned_frac: 0.0, min_aligned_bp: 0],
    ]

    // --- Binning (BIN_TARGET / C3) ---

    // Per-target binning criteria — spec §3.7.6. A contig is a target
    // candidate where its merged aligned fraction and identity against
    // ${assembly_target}.mmi clear these floors AND its merged aligned
    // fraction exceeds that against every sibling organelle panel.
    //
    // These are PROTOTYPE DEFAULTS calibrated on three integration
    // fixtures, not validated thresholds — spec §9 item 10. Those
    // fixtures are correctness tests, not benchmarks (spec §5.1), so
    // "the fixtures pass" is not evidence these values are right.
    //
    //   min_identity           merged identity floor, percent
    //   min_aligned_frac       merged aligned-fraction floor
    //   emit                   'single' (top-ranked) | 'all' candidates
    //   max_contigs            cap on emitted contigs when emit = 'all'
    //   low_coverage_fraction  candidates below this fraction of the
    //                          top candidate's coverage are emitted but
    //                          flagged as possible NUMT/NUPT (§3.7.3)
    //   sibling_warn_fraction  warn in the report when more than this
    //                          fraction of assembled bases bins as the
    //                          sibling organelle — the pre-assembly
    //                          coverage estimate over-stated target
    //                          depth (§2.1.5, task 25 §3.1)
    bin_target_thresholds = [
        animal_mt: [
            min_identity: 80.0, min_aligned_frac: 0.30,
            emit: 'single', max_contigs: 1,
            low_coverage_fraction: 0.05, sibling_warn_fraction: 0.30,
        ],
        plant_pt: [
            min_identity: 75.0, min_aligned_frac: 0.30,
            emit: 'single', max_contigs: 1,
            low_coverage_fraction: 0.05, sibling_warn_fraction: 0.30,
        ],
        plant_mt: [
            min_identity: 70.0, min_aligned_frac: 0.15,
            emit: 'all', max_contigs: 20,
            low_coverage_fraction: 0.05, sibling_warn_fraction: 0.30,
        ],
    ]

    // --- Validation schema ---
    validate_params         = true
}

validation {
    monochromeLogs          = false
    defaultIgnoreParams     = ['validate_params']
}

// Load process resource labels
includeConfig 'conf/base.config'

// Load container map
includeConfig 'conf/containers.config'

profiles {
    stub                 { includeConfig 'conf/stub.config'                  }
    integration          { includeConfig 'conf/integration.config'           }
    azure                { includeConfig 'conf/azure.config'                 }
    docker  {
        docker.enabled          = true
        docker.runOptions       = '-u $(id -u):$(id -g) --platform linux/amd64'
        singularity.enabled     = false
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        docker.enabled          = false
    }
}
