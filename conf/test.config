// Test profile — 2-sample synthetic run against fixtures in tests/data/.
// All reference paths point at empty placeholder files; stubs don't read them.

params {
    samplesheet   = "${projectDir}/tests/data/samples.csv"
    data_dir      = "${projectDir}/tests/data"
    outdir        = "${projectDir}/tests/output"
    kingdom_refs  = "${projectDir}/tests/data/refs/kingdom_refs.mmi"
    locus_panel   = "${projectDir}/tests/data/refs/locus_panel.faa"
    blast_db      = "${projectDir}/tests/data/refs/blast_db"

    // Relax resource limits for CI (these are params only; see process block below)
    max_cpus      = 2
    max_memory    = '4.GB'
    max_time      = '30.m'

    publish_intermediates = false
}

process {
    // Cap all process resources for local/CI runs
    resourceLimits = [
        cpus  : 2,
        memory: '4.GB',
        time  : '30.m',
    ]
}

docker {
    enabled    = true
    runOptions = '--platform linux/amd64'
}
