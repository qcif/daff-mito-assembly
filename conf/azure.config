// Azure Batch executor profile, run via deploy/azure/run-wf5-azure.sh.
// Credentials come from .env.azure (not committed). The launcher also
// sets the per-run values: WF5_AZURE_POOL, WF5_AZURE_WORKDIR and
// WF5_AZURE_CACHE. WF5_AZURE_WORKDIR is optional: a caller such as
// Cloudgene can instead pass -work-dir az://..., which overrides it.
// Reference-data params are the launcher's job, so one profile serves any
// bundle version.
//
// The nf-azure plugin is pinned in nextflow.config (plugins cannot be
// declared inside a profile).

// A null credential only surfaces as an opaque auth error deep in the
// plugin, so fail here with the variable's name.
['AZURE_BATCH_ACCOUNT_NAME', 'AZURE_BATCH_ACCESS_KEY',
 'STORAGE_ACCOUNT_STD', 'AZURE_STORAGE_ACCOUNT_KEY',
 'WF5_AZURE_POOL', 'WF5_AZURE_CACHE'].each { name ->
    if (!System.getenv(name)) {
        throw new IllegalStateException(
            "conf/azure.config: environment variable ${name} is not set "
            + "(see .env.sample and docs/azure/setup.md)")
    }
}

// -work-dir on the command line takes precedence over this. It must be an
// az:// URI: the Azure Batch executor cannot use a local work dir.
workDir = System.getenv('WF5_AZURE_WORKDIR') ?: 'az://workdata/wf5/default'

// -resume state lives next to the work dir, not in one launcher's .nextflow/
cloudcache {
    enabled = true
    path    = System.getenv('WF5_AZURE_CACHE')
}

azure {
    batch {
        location               = 'australiaeast'
        accountName            = System.getenv('AZURE_BATCH_ACCOUNT_NAME')
        accountKey             = System.getenv('AZURE_BATCH_ACCESS_KEY')
        autoPoolMode           = false
        allowPoolCreation      = false
        deleteJobsOnCompletion = true
        // azcopy is installed by the pool's start task (deploy/azure/setup.sh)
        copyToolInstallMode    = 'off'
    }
    storage {
        accountName = System.getenv('STORAGE_ACCOUNT_STD')
        accountKey  = System.getenv('AZURE_STORAGE_ACCOUNT_KEY')
    }
}

process {
    executor = 'azurebatch'
    queue    = System.getenv('WF5_AZURE_POOL')
}

docker {
    enabled = true
}
