// Azure Batch executor profile.
// Requires environment variables set in .env.azure (not committed):
//   AZURE_BATCH_ACCOUNT_NAME, AZURE_BATCH_ACCOUNT_KEY,
//   AZURE_STORAGE_ACCOUNT_NAME, AZURE_STORAGE_ACCESS_KEY

azure {
    batch {
        location         = 'australiaeast'
        accountName      = System.getenv('AZURE_BATCH_ACCOUNT_NAME')
        accountKey       = System.getenv('AZURE_BATCH_ACCOUNT_KEY')
        autoPoolMode     = true
        allowPoolCreation = true
        deleteJobsOnCompletion = true
        pools {
            auto {
                vmType         = 'Standard_D4s_v3'
                vmCount        = 5
                autoScale      = true
                maxVmCount     = 20
            }
        }
    }
    storage {
        accountName      = System.getenv('AZURE_STORAGE_ACCOUNT_NAME')
        accountKey       = System.getenv('AZURE_STORAGE_ACCESS_KEY')
    }
}

process {
    executor = 'azurebatch'
}

docker {
    enabled = true
}
