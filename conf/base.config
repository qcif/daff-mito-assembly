process {
    // A failing command anywhere in a pipe fails the task.
    shell  = ['/bin/bash', '-euo', 'pipefail']

    cpus   = 1
    memory = '2.GB'
    time   = '1.h'

    // Default to per-sample crash isolation (task 49): a real-tool
    // failure on one sample (e.g. Flye assembling 0 contigs) must not
    // abort the whole batch — spec's `error` sample_status exists
    // precisely for this case (§6a.4/§2, CONSTITUTION principle 7).
    // COVERAGE_GATE carried this alone before task 49 generalised it.
    // Whole-run, non-per-sample gates override back to the fail-loud
    // default below.
    // The closure prints the failed task's identity and stderr tail to
    // the console, since Nextflow only prints "Error is ignored", and
    // copies the task logs into <outdir>/errors/.
    errorStrategy = {
        def lines = []
        try {
            lines = task.workDir.resolve('.command.err').text
                .readLines().takeRight(20)
        } catch (Exception e) {
            lines = ["(could not read .command.err: ${e.message})"]
        }
        // Copy the task logs to <outdir>/errors/<PROCESS>/<tag>.<ext>
        // through a stream, as Azure Blob has no PosixFileAttributeView.
        try {
            def dir = new File("${params.outdir}/errors/${task.process}")
            dir.mkdirs()
            ['out', 'err', 'log'].each { ext ->
                def src = task.workDir.resolve(".command.${ext}")
                if (java.nio.file.Files.exists(src)) {
                    src.withInputStream { ins ->
                        new File(dir, "${task.tag}.${ext}")
                            .withOutputStream { it << ins }
                    }
                }
            }
        } catch (Exception e) {
            System.err.println("WF5: could not copy task logs: ${e.message}")
        }
        System.err.println(
            "\nWF5 TASK FAILED (ignored): ${task.process} " +
            "(${task.tag}) exit status ${task.exitStatus}\n" +
            "  work dir: ${task.workDir}\n" +
            lines.collect { "  | ${it}" }.join('\n'))
        return 'ignore'
    }

    withName: 'VALIDATE_SAMPLESHEET' {
        errorStrategy = 'terminate'
    }
    withName: 'RUN_REPORT' {
        errorStrategy = 'terminate'
    }

    // barrnap loads the Rfam covariance models; memory is set by name so
    // it does not follow the process_low label.
    withName: 'BARRNAP' {
        memory = '6.GB'
    }

    withLabel: process_low {
        cpus   = 2
        memory = '4.GB'
        time   = '2.h'
    }
    withLabel: process_medium {
        cpus   = 4
        memory = '16.GB'
        time   = '4.h'
    }
    withLabel: process_high {
        cpus   = 8
        memory = '32.GB'
        time   = '12.h'
    }
    withLabel: process_long {
        cpus   = 4
        memory = '16.GB'
        time   = '24.h'
    }
}
