process {
    // A failing command anywhere in a pipe fails the task.
    shell  = ['/bin/bash', '-euo', 'pipefail']

    cpus   = 1
    memory = '2.GB'
    time   = '1.h'

    // Default to per-sample crash isolation (task 49): a real-tool
    // failure on one sample (e.g. Flye assembling 0 contigs) must not
    // abort the whole batch — spec's `error` sample_status exists
    // precisely for this case (§6a.4/§2, CONSTITUTION principle 7).
    // COVERAGE_GATE carried this alone before task 49 generalised it.
    // Whole-run, non-per-sample gates override back to the fail-loud
    // default below.
    // The closure prints the failed task's identity and stderr tail to
    // the console, since Nextflow only prints "Error is ignored".
    errorStrategy = {
        def lines = []
        try {
            lines = task.workDir.resolve('.command.err').text
                .readLines().takeRight(20)
        } catch (Exception e) {
            lines = ["(could not read .command.err: ${e.message})"]
        }
        System.err.println(
            "\nWF5 TASK FAILED (ignored): ${task.process} " +
            "(${task.tag}) exit status ${task.exitStatus}\n" +
            "  work dir: ${task.workDir}\n" +
            lines.collect { "  | ${it}" }.join('\n'))
        return 'ignore'
    }

    withName: 'VALIDATE_SAMPLESHEET' {
        errorStrategy = 'terminate'
    }
    withName: 'RUN_REPORT' {
        errorStrategy = 'terminate'
    }

    withLabel: process_low {
        cpus   = 2
        memory = '4.GB'
        time   = '2.h'
    }
    withLabel: process_medium {
        cpus   = 4
        memory = '16.GB'
        time   = '4.h'
    }
    withLabel: process_high {
        cpus   = 8
        memory = '32.GB'
        time   = '12.h'
    }
    withLabel: process_long {
        cpus   = 4
        memory = '16.GB'
        time   = '24.h'
    }
}
