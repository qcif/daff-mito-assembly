// Integration profile — real Tier 2 fixtures + production refs.
// Runs nightly (see .github/workflows/integration.yml).
// Fixtures fetched by tests/integration/fetch_fixtures.sh before invoking nextflow.

params {
    samplesheet          = "${projectDir}/tests/integration/samples.csv"
    data_dir             = "${projectDir}/tests/integration/fetched"
    organelle_refs       = "${projectDir}/refs/v2026.09/recruit"
    protein_panel        = "${projectDir}/refs/v2026.09/proteins"
    blast_db             = "${projectDir}/refs/v2026.09/validate"
    outdir               = "${projectDir}/tests/integration/output"
    publish_intermediates = true
}

process {
    // Cap to what ubuntu-latest runners provide (2 vCPU / ~14 GB usable)
    resourceLimits = [ cpus: 2, memory: '14.GB', time: '60.m' ]
}

docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g) --platform linux/amd64'
}
