// Container map — one entry per process.
// Off-the-shelf tool stages use biocontainers; bespoke stages use wf5/* images
// (built from scripts/Dockerfile, tagged from neoformit/daff-wf5-scripts:<sha>).
//
// STUB PHASE (P0): all processes not yet wired to a real tool use
// python:3.12-slim so `touch` works.
// Replace each tag as the real tool image is wired in P1+.
// Never use 'latest' — every tag must be pinned.

process {
    // ---- Custom logic (bespoke wf5 image) --------------------------------
    // TODO: replace python:3.12-slim with neoformit/daff-wf5-scripts:<sha>
    //       once the image is built from scripts/Dockerfile + requirements.txt
    withName: 'VALIDATE_SAMPLESHEET' {
        container = 'python:3.12-slim'
    }
    withName: 'PARSE_SAMPLESHEET' {
        container = 'python:3.12-slim'
    }
    // minimap2 added by task 25 — C2 splits the recruited pool by
    // organelle panel before estimating coverage (spec §2.1.5).
    withName: 'COVERAGE_GATE' {
        container = 'neoformit/daff-wf5-coverage-gate:python3.12_seqkit2.13_seqtk1.5_minimap2-2.31@sha256:bbfec02eb9670d3bf8a0209bfd00a595f45fce9f3ff7189f7e38f5057cab07e8'
    }
    withName: 'BIN_TARGET' {
        container = 'neoformit/daff-wf5-bin-target:python3.12_minimap2-2.31_biopython-1.85@sha256:532a372c92e6e3152be9f1da4c2f4201e44d76721900fd8faa03cf2bebce1698'
    }
    // C6/C7/the Jinja report renderer share one image (spec §6a.5):
    // Python + jinja2 + jsonschema, added to requirements.txt in task
    // 42 even though only the JSON half (schema validation) is used
    // until task 43 lands the renderer — so that task inherits a
    // working image rather than building one mid-task (rule 12).
    withName: 'COLLATE' {
        container = 'neoformit/daff-wf5-scripts:684d981@sha256:2fcdfbdeac14630f0dce95f0941043e67e8229586559cefec911fee3449fd3b2'
    }
    withName: 'RUN_REPORT' {
        container = 'neoformit/daff-wf5-scripts:684d981@sha256:2fcdfbdeac14630f0dce95f0941043e67e8229586559cefec911fee3449fd3b2'
    }

    // ---- Off-the-shelf tool stages (stub → real image in listed phase) ---
    withName: 'NANOPLOT_RAW|NANOPLOT_CLEAN' {
        container = 'quay.io/biocontainers/nanoplot:1.47.1--pyhdfd78af_0'
    }
    withName: 'CHOPPER' {
        container = 'quay.io/biocontainers/chopper:0.13.0--h7f49ad2_0'
    }
    withName: 'FILTLONG' {
        container = 'quay.io/biocontainers/filtlong:0.3.1--h077b44d_0'
    }
    // Shares C2's image: since task 28's follow-up RECRUIT filters on PAF
    // via recruit_filter.py it needs python3 + minimap2 + seqtk and no
    // longer needs samtools — exactly the coverage-gate image, already
    // SHA-pinned, so no new build (CONSTITUTION rule 12).
    withName: 'RECRUIT' {
        container = 'neoformit/daff-wf5-coverage-gate:python3.12_seqkit2.13_seqtk1.5_minimap2-2.31@sha256:bbfec02eb9670d3bf8a0209bfd00a595f45fce9f3ff7189f7e38f5057cab07e8'
    }
    withName: 'METAFLYE' {
        container = 'quay.io/biocontainers/flye:2.9.6--py311h93bbee8_1@sha256:eb57665b9d12c43f1112cfd7af64ffd94236a815ff1794298088b01500632b9f'
    }
    withName: 'MEDAKA' {
        container = 'python:3.12-slim'
        // TODO P2: quay.io/biocontainers/medaka:2.2.2--py312h3050eb1_0
    }
    withName: 'BANDAGE_NG' {
        container = 'quay.io/biocontainers/bandage_ng:2026.6.1--hca0ed12_0@sha256:dfc461d4795bc7186a6549ec1fe4dfaf23c861c582add29b70a4bae34dbaf1fc'
    }
    withName: 'BLAST_VALIDATE' {
        container = 'quay.io/biocontainers/blast:2.17.0--h66d330f_0@sha256:78e8ebf231ce498b0015100a891693ef2acbbf7df60b33299517ca2b4891e567'
    }
    // MITOS2 supplies tRNA/rRNA for animal_mt (task 31); plant_pt/plant_mt
    // skip the MITOS2 call and run C8 directly in this same image (§6).
    withName: 'ANNOTATE' {
        container = 'quay.io/biocontainers/mitos:2.1.10--pyhdfd78af_0@sha256:36541c15ec4d3f0e2e7da6f41cb511b9ea08c08708eece4c3d67b48bc866148a'
    }
    withName: 'MINIPROT_CDS' {
        container = 'quay.io/biocontainers/miniprot:0.18--h577a1d6_0@sha256:2eb53fea53743b56b1c10ac4b202469b92db959ffbb8bafd83156fdbde80e22f'
    }
    // C9 (bin/select_genetic_code.py) needs only stdlib Python — the
    // miniprot biocontainer above has none, so it shares
    // EXTRACT_BARCODES's already-pinned wf5/scripts image rather than
    // a new build (CONSTITUTION rule 12, task 38 §2/§3).
    withName: 'SELECT_GENETIC_CODE' {
        container = 'neoformit/daff-wf5-scripts:5596079@sha256:4fc343f1f6d8659c1dcedcedb5442f7ea5b46dc3d81b85242f91a03938f1aeb7'
    }
    withName: 'EXTRACT_BARCODES' {
        container = 'neoformit/daff-wf5-scripts:5596079@sha256:4fc343f1f6d8659c1dcedcedb5442f7ea5b46dc3d81b85242f91a03938f1aeb7'
    }
    withName: 'ORGANELLE_MAP' {
        container = 'python:3.12-slim'
        // TODO P4: tool selection deferred — see plan.md §8.
    }
    // Task 40 confidence scoring — split across three processes
    // because the BLAST biocontainer below carries no Python at all
    // (confirmed: `docker run ... blast:2.17.0 which python3` finds
    // nothing). Translate + join share EXTRACT_BARCODES's already-
    // pinned wf5-scripts image (python3.12 + biopython); the blastp
    // step in between reuses BLAST_VALIDATE's pinned BLAST 2.17.0
    // image. No new image built for this task (rule 12/19).
    withName: 'TRANSLATE_ANNOTATION_CDS' {
        container = 'neoformit/daff-wf5-scripts:5596079@sha256:4fc343f1f6d8659c1dcedcedb5442f7ea5b46dc3d81b85242f91a03938f1aeb7'
    }
    withName: 'SCORE_ANNOTATION_BLASTP' {
        container = 'quay.io/biocontainers/blast:2.17.0--h66d330f_0@sha256:78e8ebf231ce498b0015100a891693ef2acbbf7df60b33299517ca2b4891e567'
    }
    withName: 'JOIN_ANNOTATION_SCORES' {
        container = 'neoformit/daff-wf5-scripts:5596079@sha256:4fc343f1f6d8659c1dcedcedb5442f7ea5b46dc3d81b85242f91a03938f1aeb7'
    }
}
