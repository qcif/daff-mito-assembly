// Profile for negative-path integration test: duplicate sample_id.
// nextflow run main.nf -profile test_bad_samplesheet should exit non-zero
// from VALIDATE_SAMPLESHEET before any per-sample process is scheduled.

params {
    samplesheet  = "${projectDir}/tests/data/samples_bad.csv"
    data_dir     = "${projectDir}/tests/data"
    outdir       = "${projectDir}/tests/output_bad"
    kingdom_refs = "${projectDir}/tests/data/refs/kingdom_refs.mmi"
    locus_panel  = "${projectDir}/tests/data/refs/locus_panel.faa"
    blast_db     = "${projectDir}/tests/data/refs/blast_db"
}

process {
    resourceLimits = [
        cpus  : 2,
        memory: '4.GB',
        time  : '30.m',
    ]
}

docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g) --platform linux/amd64'
}
